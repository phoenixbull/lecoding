# Select openai_responses or openai_chat_completions to match the provider endpoint.
LECODING_MODEL_PROTOCOL=openai_responses
LECODING_MODEL_BASE_URL=https://api.provider.example/v1
LECODING_MODEL_API_KEY=replace-with-provider-secret
LECODING_MODEL_ID=provider-model-id

# Required only when producing a cost-accounted golden baseline.
LECODING_MODEL_INPUT_USD_PER_MILLION=0
LECODING_MODEL_OUTPUT_USD_PER_MILLION=0

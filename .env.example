# Select openai_responses or openai_chat_completions to match the provider endpoint.
LECODING_MODEL_PROTOCOL=openai_responses
LECODING_MODEL_BASE_URL=https://api.provider.example/v1
LECODING_MODEL_API_KEY=replace-with-provider-secret
LECODING_MODEL_ID=provider-model-id

# Production Worker composition. workspacePath must be one dedicated child of root.
LECODING_WORKER_ID=worker-01
LECODING_PROJECT_ID=project-01
# Must point to the reviewed source baseline, outside the managed worktree root.
LECODING_PROJECT_CONFIG_PATH=/absolute/path/to/source/.ai-agent/project.yaml
LECODING_WORKTREE_ROOT=/absolute/path/to/managed-worktrees
LECODING_WORKSPACE_PATH=/absolute/path/to/managed-worktrees/run-workspace
# Production composition rejects mutable tags and requires an immutable digest.
LECODING_DOCKER_IMAGE=registry.example/lecoding@sha256:replace-with-64-hex-digest
# Optional recovery tuning; the default is 5000 milliseconds.
LECODING_RECOVERY_INTERVAL_MS=5000

# Required only when producing a cost-accounted golden baseline.
LECODING_MODEL_INPUT_USD_PER_MILLION=0
LECODING_MODEL_OUTPUT_USD_PER_MILLION=0

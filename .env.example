# Select openai_responses or openai_chat_completions to match the provider endpoint.
LECODING_MODEL_PROTOCOL=openai_responses
LECODING_MODEL_BASE_URL=https://api.provider.example/v1
LECODING_MODEL_API_KEY=replace-with-provider-secret
LECODING_MODEL_ID=provider-model-id

# Production Worker composition. Each Run worktree is created below the root.
LECODING_WORKER_ID=worker-01
# Keep this URI in a secret manager in production; it is consumed by pg Pool/Client.
LECODING_DATABASE_URL=postgresql://lecoding:replace-with-database-secret@127.0.0.1:5432/lecoding
# Optional bounded PostgreSQL readiness settings.
LECODING_DATABASE_POOL_MAX=10
LECODING_DATABASE_CONNECT_TIMEOUT_MS=5000
# Optional multi-project source of truth. When set, the three legacy project
# variables below are ignored; see docs/project-registry.example.json.
LECODING_PROJECT_REGISTRY_PATH=
# Legacy single-project fallback when no registry path is set.
LECODING_PROJECT_ID=project-01
# Must point to the reviewed source baseline, outside every managed worktree root.
LECODING_PROJECT_CONFIG_PATH=/absolute/path/to/source/.ai-agent/project.yaml
LECODING_WORKTREE_ROOT=/absolute/path/to/managed-worktrees
# Production composition rejects mutable tags and requires an immutable digest.
LECODING_DOCKER_IMAGE=registry.example/lecoding@sha256:replace-with-64-hex-digest
# Project-specific image built from docker/verification.Dockerfile and the reviewed lockfile.
LECODING_VERIFICATION_IMAGE=registry.example/lecoding-verification@sha256:replace-with-64-hex-digest
# Durable pg-boss recovery scan cadence; 1–3600000 ms, rounded up to seconds.
LECODING_RECOVERY_INTERVAL_MS=5000
# Optional SSE outbox polling; the default is 100 milliseconds.
LECODING_EVENT_DISPATCH_INTERVAL_MS=100
# Loopback remains unauthenticated by default. Set a 32+ character token for
# legacy single-user protection, or select database_sessions for Phase 2 login.
LECODING_HTTP_HOST=127.0.0.1
LECODING_HTTP_PORT=8787
LECODING_HTTP_AUTH_TOKEN=
# database_sessions uses GitHub OAuth, hashed PostgreSQL sessions, and memberships.
# It is mutually exclusive with LECODING_HTTP_AUTH_TOKEN.
LECODING_AUTH_MODE=
LECODING_PUBLIC_ORIGIN=https://agent.example
LECODING_GITHUB_CLIENT_ID=
LECODING_GITHUB_CLIENT_SECRET=
# Comma-separated login allowlists; at least one organization or email is required.
LECODING_GITHUB_ALLOWED_ORGANIZATIONS=
LECODING_GITHUB_ALLOWED_EMAILS=
# Explicit emails allowed to claim the one-time initial admin role for empty projects.
LECODING_GITHUB_BOOTSTRAP_ADMIN_EMAILS=
# Required as an explicit deployment assertion for any non-loopback bind.
LECODING_HTTP_BEHIND_TLS_PROXY=0

# Required immutable provider-price snapshot used by production Run accounting.
LECODING_MODEL_PRICING_VERSION=provider-price-card-2026-08-28
LECODING_MODEL_INPUT_USD_PER_MILLION=0.14
LECODING_MODEL_OUTPUT_USD_PER_MILLION=0.28
# Provider-neutral request envelope; output is sent as the protocol's hard cap.
LECODING_MODEL_MAX_INPUT_TOKENS=240000
LECODING_MODEL_MAX_OUTPUT_TOKENS=16000
# V3 default Run guards; override only through a reviewed deployment policy.
LECODING_RUN_MAX_TOTAL_TOKENS=1000000
LECODING_RUN_COST_WARNING_USD=1
LECODING_RUN_COST_MAX_USD=2
LECODING_RUN_MAX_WALL_TIME_MS=1800000
LECODING_RUN_MAX_TOOL_CALLS=60
LECODING_USER_MAX_ACTIVE_RUNS=2
LECODING_PROJECT_MAX_ACTIVE_RUNS=5
# USD equivalent of the reviewed team policy; warning defaults to 80% when omitted.
LECODING_TEAM_MONTHLY_MAX_USD=420
LECODING_TEAM_MONTHLY_WARNING_USD=336
# Optional live-eval suite: representative (5) or acceptance (12).
LECODING_GOLDEN_SUITE=representative

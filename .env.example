# Select openai_responses or openai_chat_completions to match the provider endpoint.
LECODING_MODEL_PROTOCOL=openai_responses
LECODING_MODEL_BASE_URL=https://api.provider.example/v1
LECODING_MODEL_API_KEY=replace-with-provider-secret
LECODING_MODEL_ID=provider-model-id

# Production Worker composition. Each Run worktree is created below the root.
LECODING_WORKER_ID=worker-01
# Keep this URI in a secret manager in production; it is consumed by pg Pool/Client.
LECODING_DATABASE_URL=postgresql://lecoding:replace-with-database-secret@127.0.0.1:5432/lecoding
# Optional bounded PostgreSQL readiness settings.
LECODING_DATABASE_POOL_MAX=10
LECODING_DATABASE_CONNECT_TIMEOUT_MS=5000
LECODING_PROJECT_ID=project-01
# Must point to the reviewed source baseline, outside the managed worktree root.
LECODING_PROJECT_CONFIG_PATH=/absolute/path/to/source/.ai-agent/project.yaml
LECODING_WORKTREE_ROOT=/absolute/path/to/managed-worktrees
# Production composition rejects mutable tags and requires an immutable digest.
LECODING_DOCKER_IMAGE=registry.example/lecoding@sha256:replace-with-64-hex-digest
# Project-specific image built from docker/verification.Dockerfile and the reviewed lockfile.
LECODING_VERIFICATION_IMAGE=registry.example/lecoding-verification@sha256:replace-with-64-hex-digest
# Optional recovery tuning; the default is 5000 milliseconds.
LECODING_RECOVERY_INTERVAL_MS=5000
# Optional SSE outbox polling; the default is 100 milliseconds.
LECODING_EVENT_DISPATCH_INTERVAL_MS=100
# Loopback remains unauthenticated by default. Set a 32+ character token to protect API/SSE.
LECODING_HTTP_HOST=127.0.0.1
LECODING_HTTP_PORT=8787
LECODING_HTTP_AUTH_TOKEN=
# Required as an explicit deployment assertion for any non-loopback bind.
LECODING_HTTP_BEHIND_TLS_PROXY=0

# Required only when producing a cost-accounted golden baseline.
LECODING_MODEL_INPUT_USD_PER_MILLION=0
LECODING_MODEL_OUTPUT_USD_PER_MILLION=0
# Optional live-eval suite: representative (5) or acceptance (12).
LECODING_GOLDEN_SUITE=representative

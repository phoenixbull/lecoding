{
  "name": "lecoding-agent",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20.20.0"
  },
  "scripts": {
    "build": "turbo run build",
    "smoke:postgres-cancel": "pnpm --filter @lecoding/worker smoke:postgres-cancel",
    "smoke:postgres-failover": "pnpm --filter @lecoding/worker smoke:postgres-failover",
    "smoke:postgres": "pnpm --filter @lecoding/worker smoke:postgres",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@lecoding/test-harness": "workspace:*",
    "@types/node": "^22.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
